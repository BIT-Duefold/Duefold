{
  "name": "duefold",
  "productName": "归序",
  "version": "0.1.93",
  "private": true,
  "description": "归序 · 把分散的截止日，整理成有序的每一天",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "review": "npm run build && npm run desktop -- --review",
    "build": "tsc --noEmit && vite build",
    "build:widget-native": "node scripts/build-widget-native.mjs",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win:portable": "npm run build && electron-builder --win portable --x64",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64",
    "sync:server": "node server/index.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "asarUnpack": [
      "electron/native/*.node"
    ],
    "appId": "cn.duefold.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Duefold-${version}-Windows.${ext}",
      "icon": "assets/duefold.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "归序",
      "unicode": true,
      "language": "2052",
      "artifactName": "Duefold-${version}-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/duefold.png",
      "artifactName": "Duefold-${version}-Linux.${ext}"
    }
  }
}
